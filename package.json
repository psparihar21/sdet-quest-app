{
  "name": "sdet-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive SDET 3 + QA Lead learning platform: lessons, coding lab, interview arena, spaced revision.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "docs:trace": "vite-node scripts/gen-traceability.ts",
    "verify:videos": "node scripts/verify-videos.mjs",
    "build:gh-pages": "tsc --noEmit -p tsconfig.json && vite build && node scripts/spa-404.mjs"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.15.0",
    "sucrase": "^3.35.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=20"
  }
}
