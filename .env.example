# SDET Quest needs no secrets to run. All variables are optional.

# Base path when hosting under a sub-path (e.g. GitHub Pages project site: /sdet-quest/)
VITE_BASE_PATH=/

# Optional: sync progress between devices through your own Supabase project.
# Both values are public by design; row-level security in the database protects the data.
# Never put the service_role (secret) key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
