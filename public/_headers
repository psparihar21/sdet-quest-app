# Security headers for Cloudflare Pages / Netlify.
# The sha256 is the inline theme script in index.html; tests/unit/headers.test.ts fails if they drift apart.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-YnUwVLm3eFeQotaTPx0E4lfxfL67hpii93QGnjl3JWc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; worker-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Always revalidate the files that decide which version of the app loads.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Learner code runs here: it may eval (to run their function) but has no network at all.
/sandbox/js.worker-*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src 'none'
  Cache-Control: public, max-age=31536000, immutable

# SQLite (WebAssembly) worker: may compile wasm and fetch its own .wasm file, nothing else.
/sandbox/sql.worker-*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'
  Cache-Control: public, max-age=31536000, immutable
